# UI module ignore rules. Keep generated files, local tooling, and audit output out of Git.

# Dependencies and build output
/vendor/
/node_modules/
/build/
/dist/
/docs/vendor/
/docs/cache/
/cache/

# Lockfiles and package manager artifacts
*.lock
composer.lock
package-lock.json
yarn.lock
yarn-error.log
npm-debug.log*
lerna-debug.log*

# Local configuration and environment
.env
.env.*
!.env.example
config/local.php
config/development.php
Homestead.yaml
Homestead.json
/.vagrant/

# IDEs and agent tooling
/.idea/
/.vscode/
/.agents/
/.codex/
/.cursor/
/.opencode/
/.qwen/
.windsurf/
.phpintel
.phpstorm.meta.php

# Local quality-tool configuration
/rector.php
/phpinsights.php
/.php-cs-fixer.php
/.php-cs-fixer.dist.php
.php-cs-fixer.cache
.phpunit.result.cache

# Audit and temporary test output
/tests/AuditCoverage/
/audit-coverage/
/tests/.claude-audit/
/\.claude-audit/
/test-results/
/workbench/
*.cache
*.tmp
*.swp
*.swo
*.stackdump
*.phar
*.jar
*:Zone.Identifier
v8-compile-cache-*/

# Logs and operating system files
*.log
error_log
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backups
*.old
*.old1
*.old2
*.backup
*.backup.*
*.backup-*
*.backup_*
*.bak
*.new

# Laravel runtime files
/storage/*.key
/public/storage
/public/hot
/public_html/storage
/public_html/hot
/public/css/compiled/
/public/js/compiled/
/public/mix-manifest.json

# Generated or legacy module paths
resources/lang/
resources/views/Components_old/
database/Migrations_old/
database/Seeders_old/
database/Factories_old/
database_old/
lang/lang/
/_docs/
/docs/archive/
/docs/archived/
/docs/legacy/
/docs/workbench/
/docs/scripts/
/docs/bashscripts/
/docs/**/archive/
/docs/**/archived/
/docs/**/legacy/
/docs/**/workbench/
/docs/**/scripts/
/docs/**/bashscripts/
/docs/phpstan/
/docs/**/*-[0-9].md
/docs/**/*-[0-9][0-9].md
/docs/**/*_[0-9].md
/docs/**/*_[0-9][0-9].md

# UI design source files and local notes
*.psd
*.sketch
*.fig
design_notes.txt

# Project-specific paths
*.fila2
/laravel/
/public_html/
/bashscripts/
/_bmad/
/_bmad-output/
/.circleci/
/.devcontainer/
/.kilocode/
/.kiro/
/.ralph/
/scripts/
/legacy/
/.ai*
