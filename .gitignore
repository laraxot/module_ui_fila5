# ==============================================
# LARAXOT MODULE: UI — .gitignore
# Grouped, deduped. See docs/wiki/rules/module-theme-root-cleanup.md
# ==============================================

# --- Dependencies & packages ---
/vendor/
/node_modules/
/docs/vendor/
composer.lock
package-lock.json
yarn.lock

# --- Build & compiled ---
/build/
/dist/
docs/cache/
cache/
docs/phpstan/
public/css/compiled/
public/js/compiled/
public/mix-manifest.json

# --- Cache & temporary ---
*.cache
*.lock
*.phar
*.jar
*.tmp
*.swp
*.swo
*.stackdump
*:Zone.Identifier
v8-compile-cache-*
.php-cs-fixer.cache
.phpunit.result.cache

# --- Logs ---
*.log
error_log
npm-debug.log*
yarn-error.log*
lerna-debug.log*

# --- Laravel runtime ---
/storage/*.key
/public/storage
/public/hot
/public_html/storage
/public_html/hot
.env
.env.*
!.env.example

# --- Environment & IDE ---
Homestead.yaml
Homestead.json
/.vagrant
/.idea
.phpintel
.phpstorm.meta.php
.windsurf/
.cursor/
.vscode/
.devcontainer/

# --- Git leftovers (merge/rebase/editor) ---
.git-rewrite/
.git-blame-ignore-revs
*~HEAD
*~BASE
*~LOCAL
*~REMOTE
*~head
*.orig
*.rej

# --- System files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
agentdb.rvf

# --- Backup / old files ---
*.old
*.old1
*.old2
*.backup
*.backup.*
*.backup-*
*.backup_*
*.bak
*.new

# --- Legacy directories (historic cleanup) ---
resources/views/Components_old/
resources/lang/
database/Migrations_old/
database/Seeders_old/
database/Factories_old/
database_old/
_docs/
lang/lang/

# --- Project-specific (UI) ---
*.fila2
laravel
public_html
config/local.php
config/development.php
*.psd
*.sketch
*.fig
design_notes.txt

# ==============================================
# AI/TOOL SCAFFOLD — must never exist in the module tree.
# Generated by AI agents / external CI, never part of the module domain.
# See docs/wiki/rules/module-theme-root-cleanup.md
# Patterns cover both module root and nested occurrences (docs/**).
# ==============================================
_bmad-output/
test-results/
tests/AuditCoverage/
.claude-audit/
tests/.claude-audit/
.circleci/
.kilocode/
.kiro/
.ralph/
scripts/
bashscripts/
docs/scripts/
docs/bashscripts/
docs/archive/
docs/archived/
docs/legacy/
docs/workbench/
docs/**/archive/
docs/**/archived/
docs/**/legacy/
docs/**/workbench/
docs/**/scripts/
docs/**/bashscripts/
